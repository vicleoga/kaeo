# ─────────────────────────────────────────────────────────────────────────────
# KAEO — variables de entorno
# Copia este fichero a `.env` y rellena los valores. `.env` NUNCA se sube a git.
# Las variables marcadas "(fase N)" aún no se usan; se documentan para preparar el despliegue.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la tienda, sin barra final. Se usa en metadatos, enlaces de emails y
# redirecciones de pago. En local: http://localhost:3000 · En producción: https://tudominio.com
# Ojo: se incrusta al compilar, así que tras cambiarla hay que reconstruir la imagen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# production | staging. En staging (p. ej. https://staging.kaeo.es) se muestra el aviso
# "tienda en pruebas" y ningún buscador indexa la web. También se incrusta al compilar.
NEXT_PUBLIC_SITE_ENV=production

# Puerto en el que Docker publica la app, y en qué interfaz. 127.0.0.1 = solo desde la propia
# máquina (recomendado: desde internet se entra por el túnel de Cloudflare).
APP_PORT=3000
APP_BIND=127.0.0.1

# ── Publicación con Cloudflare Tunnel ───────────────────────────────────────
# Servicios opcionales de docker compose que se arrancan. "tunnel" = túnel de Cloudflare.
# COMPOSE_PROFILES=tunnel
# Token del túnel (Cloudflare → Zero Trust → Networks → Tunnels → tu túnel → "Install connector").
# Es un secreto: no lo compartas ni lo subas a git.
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_USER=kaeo
# Contraseña larga y aleatoria en producción, solo letras y números (va dentro de una URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=kaeo
POSTGRES_PORT=5432
# Para `npm run dev` fuera de Docker. Dentro de docker compose se construye sola con los valores de arriba.
DATABASE_URL=postgresql://kaeo:cambia-esta-clave@localhost:5432/kaeo?schema=public

# ── Panel de administración ─────────────────────────────────────────────────
# No necesita secretos: las sesiones se guardan en la base de datos (token aleatorio en una
# cookie httpOnly; en la BD solo su hash SHA-256). La cookie es `Secure` si NEXT_PUBLIC_SITE_URL es https.
# Los administradores se crean con:  npm run admin:create -- --email tu@correo.com

# ── Fotos subidas desde el admin ────────────────────────────────────────────
# Almacenamiento: local (disco / volumen Docker). Preparado para añadir un bucket S3 compatible.
STORAGE_PROVIDER=local
# Carpeta de las subidas. En Docker ya viene fijada a /app/uploads (volumen "uploads").
# UPLOAD_DIR=./uploads

# ── Proveedores intercambiables ─────────────────────────────────────────────
# Pago: mock (pasarela simulada) | stripe (cuando se integre)
PAYMENT_PROVIDER=mock
# Secreto para firmar/verificar los webhooks de pago. OBLIGATORIO en producción
# (en desarrollo, si falta, se usa uno de pruebas). Genera uno con: openssl rand -hex 32
# PAYMENT_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=

# Producción bajo demanda: mock | gelato | printful (cuando se integre)
FULFILLMENT_PROVIDER=mock
# Igual que el de pagos, para los webhooks del proveedor de producción. OBLIGATORIO en producción.
# FULFILLMENT_WEBHOOK_SECRET=
# FULFILLMENT_API_KEY=
# Pruebas: true = el proveedor simulado rechaza todos los pedidos (para probar "requiere revisión")
# FULFILLMENT_MOCK_FAIL=false

# Email: log (muestra los emails en consola) | smtp
# EMAIL_PROVIDER=log
# EMAIL_FROM="KAEO <hola@tudominio.com>"
# EMAIL_ADMIN=pedidos@tudominio.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
