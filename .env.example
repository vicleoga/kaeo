# ─────────────────────────────────────────────────────────────────────────────
# KAEO — variables de entorno
# Copia este fichero a `.env` y rellena los valores. `.env` NUNCA se sube a git.
# Las variables marcadas "(fase N)" aún no se usan; se documentan para preparar el despliegue.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública de la tienda, sin barra final. Se usa en metadatos, enlaces de emails y
# redirecciones de pago. En local: http://localhost:3000 · En producción: https://tudominio.com
# Ojo: se incrusta al compilar, así que tras cambiarla hay que reconstruir la imagen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Puerto en el que Docker publica la app en la máquina (en producción irá detrás de Caddy).
APP_PORT=3000

# ── Base de datos (PostgreSQL) ──────────────────────────────────────────────
POSTGRES_USER=kaeo
# Contraseña larga y aleatoria en producción, p. ej.: openssl rand -base64 32
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=kaeo
POSTGRES_PORT=5432
# Para `npm run dev` fuera de Docker. Dentro de docker compose se construye sola con los valores de arriba.
DATABASE_URL=postgresql://kaeo:cambia-esta-contraseña@localhost:5432/kaeo?schema=public

# ── Sesiones del panel de administración (fase 2) ───────────────────────────
# Secreto para firmar cookies. Genera uno con: openssl rand -base64 48
# SESSION_SECRET=

# ── Proveedores intercambiables (fases 4 y 5) ───────────────────────────────
# Pago: mock | stripe
# PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Producción bajo demanda: mock | gelato | printful
# FULFILLMENT_PROVIDER=mock
# FULFILLMENT_API_KEY=
# FULFILLMENT_WEBHOOK_SECRET=

# Email: log (muestra los emails en consola) | smtp
# EMAIL_PROVIDER=log
# EMAIL_FROM="KAEO <hola@tudominio.com>"
# EMAIL_ADMIN=pedidos@tudominio.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
